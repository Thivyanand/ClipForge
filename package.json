{
  "name": "clipforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered video repurposing platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @clipforge/web",
    "dev:api": "npm run start:dev --workspace @clipforge/api",
    "build:web": "npm run build --workspace @clipforge/web",
    "build:api": "npm run build --workspace @clipforge/api",
    "lint:web": "npm run lint --workspace @clipforge/web"
  },
  "engines": { "node": ">=24" }
}
